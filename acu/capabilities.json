    "id": "uia.tree",
    "description": "Inspect a window's accessibility tree and locate named controls.",
    "runnable": true,
    "engine": "ahk",
    "instructions_file": "guides/tree.md",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "find": {
          "type": "string",
          "default": ""
        },
        "type": {
          "type": "string",
          "default": ""
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    }
  },
  {
    "id": "screen.capture",
    "description": "Capture one display, a window, or a rectangle for visual inspection.",
    "runnable": true,
    "engine": "ahk",
    "instructions_file": "guides/screenshot.md",
    "parameters": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fullscreen",
            "app",
            "custom"
          ],
          "default": "fullscreen"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "monitor": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "rect": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4,
          "default": null
        },
        "out": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "default": 1280
        }
      },
      "additionalProperties": false
    }
  },
